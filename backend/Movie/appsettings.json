{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "AzureBlobStorage": ""
  },

  "BlobStorage": {
    "Containers": {
      "Posters": "posters",
      "Backdrops": "backdrops",
      "CompanyProducer": "company-producer",
      "Director": "director",
      "UserProfile": "user-profile"
    }
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "AllowedHosts": "*",
  
  "JWT": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkew": "00:01:00",
    "AccessTokenMinutes": 60,
    "RefreshTokenHours": 168
  },
  
  "Cors": [],
  
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 12
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 10,
      "DefaultLockoutTimeSpan": "00:15:00",
      "AllowedForNewUsers": true
    }
  },

  "Swagger": {
    "Document": {
      "Name": "v1",
      "Title": "Movie API",
      "Version": "v1",
      "Description": "Movies, directors, genres, comments and ratings"
    },
    "Security": {
      "SchemeName": "Bearer",
      "Scheme": "bearer",
      "BearerFormat": "JWT",
      "HeaderName": "Authorization",
      "Description": "Paste the access token only (without 'Bearer ')"
    },
    "UI": {
      "DocumentTitle": "Movie API",
      "RoutePrefix": "swagger",
      "PersistAuthorization": true,
      "DisplayRequestDuration": true,
      "TryItOutByDefault": true,
      "EnableFilter": true,
      "DefaultModelsExpandDepth": -1
    }
  },
  
  "SeedRoles": true,

  "TMDBSettings": {
    "Host": "https://api.themoviedb.org/",
    "HostVersion": 3,
    "AccessToken": "",

    "ImageHost": "https://image.tmdb.org/t/p/",
    "PosterSize": "w500",
    "ProfileSize": "w185",
    "BackdropSize": "w1280",
    "LogoSize": "w185",

    "Endpoints": {
      "DiscoverMovies": "discover/movie",
      "MovieDetails": "movie/{0}",
      "Genres": "genre/movie/list",
      "Person": "person/{0}",
      "Company": "company/{0}"
    },

    "Query": {
      "Language": "en-US",
      "IncludeAdult": true,
      "SortBy": "primary_release_date.desc",
      "MinVoteCount": 50,
      "MinRuntime": 20,
      "AppendToResponse": "credits"
    },

    "FromDate": "1950-01-01"
  },

  "JobServices": {

    "MovieSeederJobService": {
      "Enabled": true,
      "RunOnStratUp": false,
      "CronPattern": "0 3 * * 0"
    },

    "MissingPicturesJobService": {
      "Enabled": true,
      "RunOnStratUp": false,
      "CronPattern": "0 4 * * 0"
    }
  }
}

