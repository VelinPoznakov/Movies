{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "AzureBlobStorage": ""
  },

  "BlobStorage": {
    "Containers": {
      "Posters": "posters",
      "Backdrops": "backdrops",
      "Profiles": "profiles",
      "userProfile": "user-profile"
    }
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "AllowedHosts": "*",
  
  "JWT": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkew": "00:01:00",
    "AccessTokenMinutes": 60,
    "RefreshTokenHours": 168
  },
  
  "Cors": [],
  
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 12
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 10,
      "DefaultLockoutTimeSpan": "00:15:00",
      "AllowedForNewUsers": true
    }
  },

  "Swagger": {
    "Document": {
      "Name": "v1",
      "Title": "Movie API",
      "Version": "v1",
      "Description": "Movies, directors, genres, comments and ratings"
    },
    "Security": {
      "SchemeName": "Bearer",
      "Scheme": "bearer",
      "BearerFormat": "JWT",
      "HeaderName": "Authorization",
      "Description": "Paste the access token only (without 'Bearer ')"
    },
    "UI": {
      "DocumentTitle": "Movie API",
      "RoutePrefix": "swagger",
      "PersistAuthorization": true,
      "DisplayRequestDuration": true,
      "TryItOutByDefault": true,
      "EnableFilter": true,
      "DefaultModelsExpandDepth": -1
    }
  },
  
  "SeedRoles": true,


  }
}

